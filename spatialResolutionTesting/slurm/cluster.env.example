# Copy to slurm/cluster.env and fill in:   cp slurm/cluster.env.example slurm/cluster.env
# cluster.env is gitignored, so each person keeps their own copy.
# These values were NOT checked against PACE docs (docs.pace.gatech.edu was
# unreachable when this was written). Confirm them with your PI or PACE.

# --- Who pays / which queue ------------------------------------------------
# Phoenix: charge account, usually "gts-<PI GT username>". ICE (course cluster): leave empty.
LOCEMB_ACCOUNT=""
# Phoenix QOS: "embers" = free but your job can be stopped (preempted) when paid
# jobs need the GPUs; "inferno" = charged to the account, not preempted.
# ICE: leave empty.
LOCEMB_QOS=""
# Leave empty unless PACE/your PI tells you a partition name.
LOCEMB_PARTITION=""

# --- What each job asks for ----------------------------------------------
LOCEMB_GRES="gpu:1"          # or a GPU type, e.g. gpu:A100:1, gpu:V100:1, gpu:H100:1 (check names)
LOCEMB_CONSTRAINT=""         # optional node features, e.g. "A100-80GB" if your cluster uses them
LOCEMB_TIME="04:00:00"       # wall-clock limit per run (HH:MM:SS); shorter = starts sooner
LOCEMB_CPUS="8"
LOCEMB_MEM="48G"

# --- Software & paths -----------------------------------------------------
# `module avail anaconda` or `module avail python` on the login node shows options.
LOCEMB_PYTHON_MODULE="anaconda3"
# Put the env on project storage, not $HOME (home quotas are small).
LOCEMB_ENV_DIR="$HOME/envs/locemb"
# Brain atlases cached by setup_env.sh. Empty = spatialResolutionTesting/nilearn_data.
LOCEMB_ATLAS_DIR=""
# Where Brain Treebank lives (big: put on scratch or project storage).
# Must end in /braintreebank (that's the folder Neuroprobe's download creates).
# The --lite download is 75 GB zipped (12 recordings); ~130 GB unzipped is a guess.
ROOT_DIR_BRAINTREEBANK=""
# Filtered copies of the recordings (~17 GB for the 12 Lite ones at 512 Hz, float16).
# Empty = next to ROOT_DIR_BRAINTREEBANK, in ../locemb_cache
LOCEMB_CACHE_DIR=""
